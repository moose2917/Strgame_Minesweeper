rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rankings/{rankingId} {
      allow read: true;  // Anyone can read rankings
      allow write: if request.resource.data.time is number
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 10;  // Name length limit
    }
  }
}